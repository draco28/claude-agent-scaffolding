{
  "description": "AI Mentor hooks: SessionStart resets state and injects 4-pillar protocol. PreToolUse enforces spotter mode (Curve 2) by blocking Edit/Write/NotebookEdit unless override conditions are met.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/session-start.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/pre-tool-use.sh\""
          }
        ]
      }
    ]
  }
}
