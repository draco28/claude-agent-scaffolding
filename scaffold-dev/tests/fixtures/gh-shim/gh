#!/usr/bin/env bash
# Fake gh for scaffold-dev tests. Records args to $GH_SHIM_LOG; emits canned
# output controlled by env vars. NO network. Subcommand matched on "$1 $2".
[[ -n "${GH_SHIM_LOG:-}" ]] && printf '%s\n' "$*" >> "$GH_SHIM_LOG"
case "${1:-} ${2:-}" in
  "auth status") exit "${GH_SHIM_AUTH_RC:-0}" ;;
  "pr list")     echo "${GH_SHIM_PR_LIST_URL:-}"; exit 0 ;;
  "pr create")   echo "${GH_SHIM_PR_URL:-https://github.com/test/repo/pull/123}"; exit 0 ;;
  "pr view")
    if printf '%s\n' "$*" | grep -q 'reviewThreads'; then
      echo "unknown JSON field: reviewThreads" >&2
      exit 1
    fi
    if [[ -n "${GH_SHIM_PR_VIEW_JSON:-}" && -f "$GH_SHIM_PR_VIEW_JSON" ]]; then
      cat "$GH_SHIM_PR_VIEW_JSON"
    else
      echo '{}'
    fi
    exit 0 ;;
  "pr merge")    exit "${GH_SHIM_MERGE_RC:-0}" ;;
  "issue create") echo "${GH_SHIM_ISSUE_URL:-https://github.com/test/repo/issues/7}"; exit 0 ;;
  "issue list")
    if [[ -n "${GH_SHIM_ISSUE_LIST_JSON:-}" && -f "$GH_SHIM_ISSUE_LIST_JSON" ]]; then
      cat "$GH_SHIM_ISSUE_LIST_JSON"
    else
      echo '[]'
    fi
    exit 0 ;;
  "api "*)
    # gh api … (e.g. pulls/<pr>/comments) — emit canned inline review comments
    if [[ -n "${GH_SHIM_API_RC:-}" && "${GH_SHIM_API_RC}" != "0" ]]; then
      echo "${GH_SHIM_API_ERR:-gh api failed}" >&2
      exit "$GH_SHIM_API_RC"
    fi
    # Simulate real `gh api --slurp` multi-page output: a nested array of pages.
    if [[ -n "${GH_SHIM_PR_COMMENTS_PAGED_JSON:-}" && -f "$GH_SHIM_PR_COMMENTS_PAGED_JSON" ]]; then
      cat "$GH_SHIM_PR_COMMENTS_PAGED_JSON"
    elif [[ -n "${GH_SHIM_PR_COMMENTS_JSON:-}" && -f "$GH_SHIM_PR_COMMENTS_JSON" ]]; then
      cat "$GH_SHIM_PR_COMMENTS_JSON"
    else
      echo '[]'
    fi
    exit 0 ;;
  *)             exit 0 ;;
esac
