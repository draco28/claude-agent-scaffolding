#!/usr/bin/env bash
# Recording fake for the Huly CLI. Logs argv; answers from fixture files.
set -u
: "${BOARD_FAKE_LOG:?}" "${BOARD_FAKE_DIR:?}"
printf '%s\n' "$*" >> "$BOARD_FAKE_LOG"
key=""
for a in "$@"; do
  case "$a" in -*) break;; esac
  [ -n "$key" ] && key="$key."; key="$key$a"
  # positional values after the verb are not part of the key: stop after the verb word
  case "$key" in
    projects.create|projects.get|projects.statuses|projects.list|projects.delete|\
    spaces.types.list|spaces.permissions.list|spaces.create|spaces.roles.create|\
    task-types.list|task-types.create|issue-statuses.create|\
    milestones.list|milestones.create|milestones.update|\
    issues.list|issues.create|issues.update|issues.get|issues.milestone.set|issues.labels.add|\
    issues.relations.list|issues.relations.add|comments.add|auth.status) break;;
  esac
done
rc=0
if [ -f "$BOARD_FAKE_DIR/$key.rc.once" ]; then            # one-shot: consumed on first use
  rc="$(cat "$BOARD_FAKE_DIR/$key.rc.once")"; rm -f "$BOARD_FAKE_DIR/$key.rc.once"
  [ -f "$BOARD_FAKE_DIR/$key.err.once" ] && { cat "$BOARD_FAKE_DIR/$key.err.once" >&2; rm -f "$BOARD_FAKE_DIR/$key.err.once"; }
elif [ -f "$BOARD_FAKE_DIR/$key.rc" ]; then
  rc="$(cat "$BOARD_FAKE_DIR/$key.rc")"
  [ -f "$BOARD_FAKE_DIR/$key.err" ] && cat "$BOARD_FAKE_DIR/$key.err" >&2
fi
if [ -f "$BOARD_FAKE_DIR/$key.json" ]; then cat "$BOARD_FAKE_DIR/$key.json"
else case "$key" in *.list) echo '[]';; *) echo '{}';; esac; fi
exit "$rc"
