#!/usr/bin/env bash
set -euo pipefail
BOARD_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
for _lib in "$BOARD_ROOT"/lib/*.sh; do
  # shellcheck disable=SC1090
  [ -e "$_lib" ] && . "$_lib"
done
board_cmd_help() {
  echo "board dispatcher"
  echo "  sync <dir> [--force] [--bind IDENT]   reconcile the board from .ossify/project-state.json"
  echo "  digest <dir>                          sha256 of the state file"
  echo "  env-check                             report which HULY_* variables are set (values never printed)"
}
board_cmd_sync()   { board_sync "$@"; }
board_cmd_digest() { local ws; ws="$(board_resolve_workspace "$1")"; board_state_digest "$ws"; }
board_cmd_env_check() {
  local v; for v in HULY_URL HULY_WORKSPACE HULY_TOKEN; do
    if [ -n "${!v:-}" ]; then echo "$v: set"; else echo "$v: MISSING"; fi
  done
  if [ -n "${HULY_EMAIL:-}" ]; then echo "HULY_EMAIL: set (optional — enables membership self-ensure)"
  else echo "HULY_EMAIL: not set (optional — enables membership self-ensure)"; fi
}
main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in env-check) cmd=env_check;; esac
  if declare -F "board_cmd_${cmd}" >/dev/null 2>&1; then "board_cmd_${cmd}" "$@"
  else echo "board: unknown subcommand '${cmd}'" >&2; board_cmd_help >&2; exit 2; fi
}
main "$@"
