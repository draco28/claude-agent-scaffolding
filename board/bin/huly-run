#!/usr/bin/env bash
# huly-run — the only path to the Huly CLI. Pins the version, disables telemetry,
# and refuses to run without the three env values so a misconfigured harness
# fails loudly here instead of as an opaque auth error deep in a sync.
set -euo pipefail
for v in HULY_URL HULY_WORKSPACE HULY_TOKEN; do
  if [ -z "${!v:-}" ]; then
    echo "huly-run: $v is not set (set it in the harness wrapper, never in settings.json)" >&2
    exit 2
  fi
done
export HULY_CLI_TELEMETRY=0
exec npx -y @firfi/huly-cli@0.48.2 "$@"
