#!/usr/bin/env bash
set -euo pipefail

case ":${OPENCODE_SCAFFOLDING_PLUGINS:-}:" in
  *:workspace-init:*) ;;
  *)
    echo "wi: OpenCode plugin 'workspace-init' is not selected (OPENCODE_SCAFFOLDING_PLUGINS)" >&2
    exit 2
    ;;
esac

_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_PACKAGE_ROOT="$(cd "$_BIN_DIR/../.." && pwd)"
PLUGIN_ROOT="$_PACKAGE_ROOT/workspace-init"
CLAUDE_PLUGIN_ROOT="$PLUGIN_ROOT"
export PLUGIN_ROOT CLAUDE_PLUGIN_ROOT

exec "$PLUGIN_ROOT/bin/wi" "$@"
