#!/usr/bin/env bash
set -euo pipefail

case ":${OPENCODE_SCAFFOLDING_PLUGINS:-}:" in
  *:ossify:*) ;;
  *)
    echo "oss: OpenCode plugin 'ossify' is not selected (OPENCODE_SCAFFOLDING_PLUGINS)" >&2
    exit 2
    ;;
esac

_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_PACKAGE_ROOT="$(cd "$_BIN_DIR/../.." && pwd)"
OSS_ROOT="$_PACKAGE_ROOT/ossify"
CLAUDE_PLUGIN_ROOT="$OSS_ROOT"
export OSS_ROOT CLAUDE_PLUGIN_ROOT

if [[ "${1:-}" == "critic_detect" ]]; then
  case ":${OPENCODE_SCAFFOLDING_PLUGINS}:" in
    *:architect-critic:*)
      _CRITIC_ROOT="$_PACKAGE_ROOT/architect-critic"
      if [[ -f "$_CRITIC_ROOT/skills/critiquing-spec/SKILL.md" ]]; then
        if [[ -f "$_CRITIC_ROOT/skills/managing-async-critique/SKILL.md" ]]; then
          echo "v0.3"
        else
          echo "v0.2"
        fi
        exit 0
      fi
      ;;
  esac
fi

exec "$OSS_ROOT/bin/oss" "$@"
