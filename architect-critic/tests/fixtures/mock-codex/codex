#!/usr/bin/env bash
# Mock codex CLI for hermetic tests (v0.2 codex 0.125+ semantics).
#
# v0.2 invocation shape that this mock emulates:
#   codex exec --json \
#     --output-schema PATH \
#     --output-last-message PATH \
#     --ignore-user-config --ignore-rules \
#     --skip-git-repo-check \
#     [-c model="NAME"] \
#     "<prompt>"
#
# Behavior:
#   - Records full argv (one arg per line) to "$MOCK_CODEX_ARGV_LOG" if set.
#   - Locates the value following `--output-last-message` in argv and writes the
#     contents of $MOCK_CODEX_OUTPUT to that path (this is what real codex does:
#     the schema-constrained final answer goes to that file, not stdout).
#   - Optionally streams a dummy JSONL line to stdout to simulate --json mode.
#
# Env vars honored:
#   MOCK_CODEX_OUTPUT     path to JSON payload to write into --output-last-message file
#   MOCK_CODEX_ARGV_LOG   path to log captured argv (one arg per line)
#   MOCK_CODEX_SLEEP      seconds to sleep before doing anything (timeout tests)
#   MOCK_CODEX_EXIT_CODE  exit with this code instead of 0 (non-zero exit tests)
#   MOCK_CODEX_SKIP_WRITE if set, do NOT write the last-message file (simulates
#                         codex refusing to emit due to schema violation upstream)

# Log argv if requested (before any sleep — capture is the priority).
if [[ -n "${MOCK_CODEX_ARGV_LOG:-}" ]]; then
  : > "$MOCK_CODEX_ARGV_LOG"
  for a in "$@"; do
    printf '%s\n' "$a" >> "$MOCK_CODEX_ARGV_LOG"
  done
fi

# Honor sleep before doing anything else (for timeout testing).
if [[ -n "${MOCK_CODEX_SLEEP:-}" ]]; then
  sleep "${MOCK_CODEX_SLEEP}"
fi

# Honor custom exit code (for non-zero exit testing).
if [[ -n "${MOCK_CODEX_EXIT_CODE:-}" ]]; then
  exit "${MOCK_CODEX_EXIT_CODE}"
fi

# Find the value following `--output-last-message` in argv.
LAST_MSG_PATH=""
prev=""
for a in "$@"; do
  if [[ "$prev" == "--output-last-message" ]]; then
    LAST_MSG_PATH="$a"
    break
  fi
  prev="$a"
done

# Stream a dummy JSONL line to stdout to simulate --json mode (consumers may
# ignore stdout — the canonical answer is in the last-message file).
printf '{"type":"mock","msg":"streaming-placeholder"}\n'

# Write the payload to the last-message file (this is the real "result").
if [[ -z "${MOCK_CODEX_SKIP_WRITE:-}" ]]; then
  if [[ -z "${MOCK_CODEX_OUTPUT:-}" ]]; then
    echo "mock-codex: MOCK_CODEX_OUTPUT not set" >&2
    exit 1
  fi
  if [[ ! -f "$MOCK_CODEX_OUTPUT" ]]; then
    echo "mock-codex: payload not found: $MOCK_CODEX_OUTPUT" >&2
    exit 1
  fi
  if [[ -z "$LAST_MSG_PATH" ]]; then
    echo "mock-codex: --output-last-message not in argv" >&2
    exit 1
  fi
  cat "$MOCK_CODEX_OUTPUT" > "$LAST_MSG_PATH"
fi

exit 0
