#!/usr/bin/env bash
# bin/sf — dispatcher entry point for scaffold-onboard
#
# Why this exists: Claude Code's Bash tool on macOS runs under zsh by default
# ($SHELL=zsh). Skill bodies that `source lib/*.sh` then inherit zsh, where
# ${BASH_SOURCE[0]} is unset and ${BASH_REMATCH[…]} returns empty silently
# (scaffold-onboard has 11 BASH_REMATCH sites in its parsers — the worst
# silent-corruption surface across the plugin lineup). This dispatcher's
# shebang (#!/usr/bin/env bash) forces bash via the kernel on direct
# execution, regardless of caller shell. Libs sourced through here get the
# bash runtime they were written for. Also obviates dependence on the
# upstream CLAUDE_PLUGIN_ROOT env var, which isn't exported to Bash tool
# subprocesses (anthropics/claude-code#48230) — the dispatcher self-locates
# from its own absolute path.
#
# Contract:
#   sf <function-suffix> [args...]
#     → resolves to sf_<function-suffix>, dispatches with remaining args.
#       Examples:
#         sf state_init                          → sf_state_init
#         sf state_mode                          → sf_state_mode
#         sf phases_questions_for "$yaml" 4      → sf_phases_questions_for …
#         sf resolve_output_path prd docs/PRD.md → sf_resolve_output_path …
#         sf spec_validate "$path"               → sf_spec_validate "$path"
#   sf --list
#     → prints all sf_-prefixed functions, one per line, sorted.
#
# Exit codes:
#   0    function ran successfully (or matched function's exit code)
#   2    usage error (no args, unknown function)
#   *    propagated verbatim from the dispatched function
# stdout/stderr are passed through unchanged — no wrapping.

set -euo pipefail

readonly _DISPATCHER_PREFIX="sf"

_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "$_BIN_DIR/.." && pwd)"
export PLUGIN_ROOT
_LIB_DIR="$PLUGIN_ROOT/lib"

if [ -f "$_LIB_DIR/_helpers.sh" ]; then
  # shellcheck source=/dev/null
  source "$_LIB_DIR/_helpers.sh"
fi
for _f in "$_LIB_DIR"/*.sh; do
  [ -e "$_f" ] || continue
  [ "$(basename "$_f")" = "_helpers.sh" ] && continue
  # shellcheck source=/dev/null
  source "$_f"
done

if [ "${1:-}" = "--list" ]; then
  declare -F \
    | awk -v pfx="${_DISPATCHER_PREFIX}_" '$3 ~ "^"pfx"[^_]" { sub(pfx, "", $3); print $3 }' \
    | sort
  exit 0
fi

if [ $# -lt 1 ]; then
  cat >&2 <<USAGE
Usage: $(basename "$0") <function-suffix> [args...]
       $(basename "$0") --list

Function suffix resolves to ${_DISPATCHER_PREFIX}_<suffix>.
Examples:
  $(basename "$0") state_init
  $(basename "$0") state_mode
  $(basename "$0") resolve_output_path prd docs/PRD.md
USAGE
  exit 2
fi

_fn="${_DISPATCHER_PREFIX}_$1"
shift
if ! declare -f "$_fn" >/dev/null 2>&1; then
  echo "Unknown function: $_fn" >&2
  echo "Run '$(basename "$0") --list' to see available functions." >&2
  exit 2
fi
"$_fn" "$@"
